# ==========================================
# Sana AI - Main Environment Configuration
# Place this file as .env in the project root:
# c:\Users\prana\Downloads\Sana-Ai--All-working\.env
# ==========================================

# --- Supabase Configuration (Required) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI Chat Engine (Required for Sana Chat) ---
# Get free API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# --- AI Web Calling (Optional) ---
# If left blank, the app automatically falls back to browser Web Speech API
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# --- Direct Postgres Database (Optional) ---
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# --- Google Classroom Integration (Optional) ---
# GOOGLE_CLASSROOM_CLIENT_ID=your-google-client-id
# GOOGLE_CLASSROOM_CLIENT_SECRET=your-google-client-secret

# --- Additional AI & YouTube Services (Optional) ---
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key
# YOUTUBE_API_KEY=your-youtube-api-key
